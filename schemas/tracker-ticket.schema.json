{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tracker-ticket.schema.json",
  "title": "Normalized ticket",
  "description": "What `fetch` returns, whichever tracker it came from.",
  "type": "object",
  "required": ["source", "id", "title", "description", "type", "status", "labels", "acceptanceCriteria", "attachments", "comments", "subtasks"],
  "additionalProperties": false,
  "properties": {
    "source": { "type": "string", "enum": ["jira", "azure", "clickup", "github", "gitlab", "bitbucket"] },
    "id": { "type": "string", "minLength": 1 },
    "url": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "type": { "type": "string", "description": "Story, Bug, Task, ... as the tracker names it" },
    "status": { "type": "string" },
    "priority": { "type": "string" },
    "labels": { "type": "array", "items": { "type": "string" } },
    "acceptanceCriteria": { "type": "string" },
    "attachments": {
      "type": "array",
      "items": { "type": "object", "required": ["name", "url"], "properties": { "name": { "type": "string" }, "url": { "type": "string" } } }
    },
    "comments": {
      "type": "array",
      "items": { "type": "object", "required": ["body"], "properties": { "author": { "type": ["string", "null"] }, "body": { "type": "string" }, "created": { "type": ["string", "null"] } } }
    },
    "subtasks": {
      "type": "array",
      "items": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string" }, "title": { "type": "string" } } }
    }
  }
}
