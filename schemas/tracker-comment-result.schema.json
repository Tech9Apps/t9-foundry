{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tracker-comment-result.schema.json",
  "title": "Result of comment",
  "type": "object",
  "required": ["id"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "url": { "type": "string" },
    "deduplicated": { "type": "boolean", "description": "true when a comment carrying the same idempotencyKey already existed and was returned instead of posting another" }
  }
}
