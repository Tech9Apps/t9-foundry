# Copy this file to .env.test and fill in your values.
# Add .env.test to .gitignore — never commit credentials.
#
# Load before running tests:
#   export $(cat .env.test | xargs) && npx wdio wdio.conf.ts

BASE_URL=https://staging.yourapp.com

# Test account credentials (use dedicated test accounts, never production credentials)
TEST_USER_EMAIL=testuser@example-test.com
TEST_USER_PASSWORD=Test@1234!
