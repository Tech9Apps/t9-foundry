# Copy this file to .env.test and fill in your values.
# .env.test is gitignored — never commit credentials.
# NEVER use production URLs or production credentials here.

BASE_URL=https://staging.myapp.com

TEST_USER_EMAIL=test-user@staging.myapp.com
TEST_USER_PASSWORD=changeme-staging-only

