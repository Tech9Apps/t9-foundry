# Copy this file to .env.test and fill in your values.
# Add .env.test to .gitignore — never commit real credentials.
#
# Load before running tests:
#   source .env.test && bundle exec rspec

BASE_URL=https://staging.myapp.com

# Credentials for test accounts — use dedicated test accounts, never production credentials
TEST_USER_PASSWORD=changeme

# Optional: point to the QA harness directory if qa-config.json is not two levels up
# QA_HARNESS_DIR=/path/to/tech9foundry
