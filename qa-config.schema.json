{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qa-config.schema.json",
  "title": "QA Harness Configuration",
  "type": "object",
  "required": ["project", "ticketSource", "codeRepository", "environments", "productionProtection"],
  "properties": {
    "project": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "ticketSource": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["jira", "azure", "clickup", "github", "gitlab", "bitbucket", "none"] },
        "jira": {
          "type": "object",
          "properties": {
            "cloudId": { "type": "string", "description": "Atlassian Cloud ID or site hostname, e.g. mycompany.atlassian.net" },
            "projectKey": { "type": "string" },
            "testIssueType": { "type": "string", "default": "Test" },
            "linkType": { "type": "string", "default": "is tested by" }
          }
        },
        "azure": {
          "type": "object",
          "properties": {
            "organization": { "type": "string" },
            "project": { "type": "string" },
            "tokenEnvVar": { "type": "string", "default": "AZURE_DEVOPS_PAT" },
            "host": { "type": "string", "default": "https://dev.azure.com" }
          }
        },
        "clickup": {
          "type": "object",
          "properties": {
            "workspaceId": { "type": "string" },
            "listId": { "type": "string" },
            "tokenEnvVar": { "type": "string", "default": "CLICKUP_TOKEN" },
            "assignToSelf": { "type": "boolean", "default": true, "description": "Assign created test tasks to the user the token belongs to" },
            "apiBaseUrl": { "type": "string", "description": "Override the API base URL (a mock for tests)" }
          }
        },
        "github": {
          "type": "object",
          "properties": {
            "repo": { "type": "string", "description": "owner/repo format" },
            "testLabelName": { "type": "string", "default": "test-case" },
            "tokenEnvVar": { "type": "string", "default": "GITHUB_TOKEN", "description": "Env var holding a GitHub token for the REST adapter (GH_TOKEN is also accepted)" },
            "apiBaseUrl": { "type": "string", "description": "Override the API base URL (GitHub Enterprise Server, or a mock for tests). A host other than api.github.com must also be allowed in your shell: QA_TRACKER_ALLOW_HOSTS" }
          }
        },
        "gitlab": {
          "type": "object",
          "properties": {
            "projectId": { "type": "string" },
            "tokenEnvVar": { "type": "string", "default": "GITLAB_TOKEN" },
            "host": { "type": "string", "default": "https://gitlab.com" },
            "testLabelName": { "type": "string", "default": "test-case", "description": "Label applied to test-case issues" }
          }
        },
        "bitbucket": {
          "type": "object",
          "properties": {
            "workspace": { "type": "string" },
            "repo": { "type": "string" },
            "username": { "type": "string", "description": "Bitbucket account username. App passwords authenticate as username:app_password, so this is required for API calls (issue creation/fetch). Not a secret." },
            "tokenEnvVar": { "type": "string", "default": "BITBUCKET_TOKEN" }
          }
        }
      }
    },
    "codeRepository": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["github", "gitlab", "bitbucket", "local"] },
        "localPath": { "type": "string", "description": "Relative or absolute path to local repo clone" },
        "sourceDirs": {
          "type": "object",
          "description": "Optional per-project hints for where key source areas live, relative to localPath. Commands fall back to discovering the structure when unset.",
          "properties": {
            "frontendRoutes": { "type": "string" },
            "components": { "type": "string" },
            "services": { "type": "string" },
            "backendHandlers": { "type": "string" },
            "constants": { "type": "string" }
          },
          "additionalProperties": { "type": "string" }
        },
        "github": {
          "type": "object",
          "properties": {
            "repo": { "type": "string", "description": "owner/repo format" }
          }
        },
        "gitlab": {
          "type": "object",
          "properties": {
            "projectId": { "type": "string" },
            "host": { "type": "string", "default": "https://gitlab.com" },
            "tokenEnvVar": { "type": "string" }
          }
        },
        "bitbucket": {
          "type": "object",
          "properties": {
            "workspace": { "type": "string" },
            "repo": { "type": "string" },
            "tokenEnvVar": { "type": "string" }
          }
        }
      }
    },
    "environments": {
      "type": "object",
      "required": ["testEnvironmentBaseUrl"],
      "properties": {
        "testEnvironmentBaseUrl": {
          "type": "string",
          "description": "Base URL for the test/staging environment. NEVER a production URL."
        },
        "testEnvironmentName": { "type": "string" },
        "approvedEnvironments": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["staging", "dev", "qa", "test", "localhost"]
        }
      }
    },
    "productionProtection": {
      "type": "object",
      "required": ["prodUrlPatterns"],
      "properties": {
        "prodUrlPatterns": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Regex patterns that identify production URLs. Used by all 5 safety layers."
        },
        "prodEnvVarValues": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["production", "prod"]
        },
        "blockOnSuspiciousUrls": { "type": "boolean", "default": true },
        "mode": {
          "type": "string",
          "enum": ["warn", "enforce"],
          "default": "warn",
          "description": "warn: heuristic URL matches only print a warning (a human is watching). enforce: heuristic matches block, and every shell command is refused while prodUrlPatterns is empty, testEnvironmentBaseUrl is unset or qa-config.json is missing. In either mode every shell command is refused while testEnvironmentBaseUrl matches a production pattern. QA_AUTONOMOUS=1 forces enforce regardless of this value."
        },
        "allowedUrlPatterns": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Regex patterns for URLs that are known-safe and exempt from the unrecognized-host check (e.g. docs or CDN links). Matched against the URL without its query string and fragment, and a pattern has to START matching inside the scheme and host (^https://partner\\.io/ or ://partner\\.io/guide): text that only appears later, in the path of another host, does not allow the URL, and a pattern that is only a path (/guide) allows nothing. Do not start a pattern with .* . Never override prodUrlPatterns. Tracker/code-host/registry URLs (github.com, dev.azure.com, api.clickup.com, registry.npmjs.org, ...) and the host of environments.testEnvironmentBaseUrl are already exempt."
        }
      }
    },
    "testFramework": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["playwright", "cypress", "selenium", "webdriverio", "jest", "pytest", "rspec", "other"]
        },
        "configPath": { "type": "string" },
        "testDir": { "type": "string" }
      }
    },
    "dataManagement": {
      "type": "object",
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["factory", "seed-rollback", "snapshot-restore", "tag-cleanup", "api-teardown"],
          "default": "factory"
        },
        "cleanupAfterEach": { "type": "boolean", "default": true },
        "cleanupOnSessionEnd": { "type": "boolean", "default": true },
        "dataFactoryPath": { "type": "string" }
      }
    },
    "testOutput": {
      "type": "object",
      "properties": {
        "testPlansDir": { "type": "string", "default": "./test-plans" },
        "testCasesDir": { "type": "string", "default": "./test-cases" },
        "analysisDir": { "type": "string", "default": "./analysis" },
        "ticketContextDir": { "type": "string", "default": "tests/cases/.ticket-context" },
        "e2eTestsPath": { "type": "string" }
      }
    }
  }
}
