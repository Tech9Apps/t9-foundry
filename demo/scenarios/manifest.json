      "cwd": "demo/app",
      "specs": [],
      "expect": [
        { "ticket": "DEMO-101", "caseId": "TC-005", "class": "product-bug", "rule": "PRD-1", "action": "act", "step": "file-bug" },
        { "ticket": "DEMO-102", "caseId": "TC-006", "class": "product-bug", "rule": "PRD-1", "action": "act", "step": "file-bug" }
      ]
    },
    {
      "id": "stale-selector",
      "what": "a UI test still looks for the old test-id of a renamed button",
